<?xml version="1.0" encoding="utf-8"?>
<!-- The two-line variant. Same single-ImageView layout as the compact one; only
     the default size and the description differ. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="100dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_readiness"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/week_widget_description" />
